# Maintainer recipe for the latest Nebula Control Center source from GitHub.
pkgname=nebula-control-center-git
pkgver=2.1.0
pkgrel=1
pkgdesc='Native Linux system monitor and control center'
arch=('x86_64' 'aarch64')
url='https://github.com/a43039646-svg/Nebula-Control-Center'
license=('GPL3')
depends=('gtk4')
makedepends=('cmake' 'gcc' 'git' 'pkgconf')
optdepends=('pciutils: extra GPU information')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf '2.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$srcdir/$pkgname" -B "$srcdir/$pkgname/build" \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/$pkgname/build"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname/build"
}
